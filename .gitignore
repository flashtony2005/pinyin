# Rust 编译产物
/target/

# nsh 运行时 / 打包产物（含 50MB APK），由 nsh component / package 重建
/.nsh/

# sherpa-onnx KWS 模型（36MB，独立下载，不打进包也不入库）
/.kws-model/

# 本地工作日志与工具缓存（私有、非源码）
/.workbuddy/
/.playwright-cli/

# 音频压缩前的原始备份（13MB，正式素材在 assets/audio/）
assets/audio.orig-*/

# 备份文件 / 日志 / Python 缓存
*.bak*
*.log
__pycache__/
*.pyc

# 调试截图 / 临时输出（adb screencap 与校验用图，不入库）
.debug-*.png
.verify-*.png
/docs_trial_panel.png
/err.txt

# 端上录音采集样本：含真人（含儿童）声音，且由 App 运行时生成，不入公开仓库
/rec/
/sdcard_rec/

# P0 训练中间产物：模型权重 / 特征缓存 / 第三方语音库，可由 tools/_p0 脚本复现
tools/_p0/tract_test/
tools/_p0/bcache/
tools/_p0/sherpa-onnx-*/
tools/_p0/*.onnx
tools/_p0/*.pt
tools/_p0/*.tar.bz2
tools/_p0/*.api.json
tools/*.f32
tools/probes/
tools/probes_indep/
assets/audio/xdf/
